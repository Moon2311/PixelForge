# Shared by the HTTP and HTTPS servers.

client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

# Uploaded product images and their variants (shared media volume).
location /media/ {
    alias /srv/media/;
    expires 7d;
    add_header Cache-Control "public";
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
}

location / {
    proxy_pass http://pixelforge_backend;
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # Original host (with port) for absolute URLs; client address chain and
    # scheme for Django, which believes them only from this proxy
    # (TRUSTED_PROXIES). $proxy_add_x_forwarded_for appends the peer address
    # to whatever the client sent; Django reads the chain right to left.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Request-ID $pf_request_id;

    # Failure handling: connection errors, timeouts and 502/503/504 move the
    # request to the next instance (POST/PATCH/... only when the request
    # never reached the first instance) and count towards max_fails.
    proxy_connect_timeout ${NGINX_PROXY_CONNECT_TIMEOUT};
    proxy_send_timeout ${NGINX_PROXY_READ_TIMEOUT};
    proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_next_upstream_tries 3;
    proxy_next_upstream_timeout 15s;

    # Responses are buffered (frees the Gunicorn worker early). A streaming
    # or SSE response opts out with the "X-Accel-Buffering: no" header,
    # which nginx honours per response.
    proxy_buffering on;
    proxy_request_buffering on;
}
