# Copy to .env for local development (python manage.py runserver).
DEBUG=True
SECRET_KEY=change-me
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pixelforge

# Redis cache (optional: without it every read goes to PostgreSQL). Docker Compose uses redis://redis:6379/1.
# With a password: redis://:<password>@host:6379/1
REDIS_URL=redis://127.0.0.1:6379/1
# CACHE_ENABLED=True
# CACHE_KEY_PREFIX=pixelforge
# CACHE_DEFAULT_TTL=300
# CACHE_TTL_JITTER=30
# NEGATIVE_CACHE_TTL=60
# NEGATIVE_CACHE_TTL_JITTER=15
# CACHE_LOCK_TTL=5.0
# CACHE_LOCK_WAIT_TIMEOUT=2.0
# CACHE_LOCK_RETRY_DELAY=0.05
# CACHE_LOCK_RETRY_MAX_DELAY=0.2
# CACHE_FAILURE_COOLDOWN=30
# REDIS_SOCKET_TIMEOUT=0.25
# CACHE_LOG_LEVEL=INFO          # DEBUG logs every hit/miss/set
# ACCESS_TOKEN_MAX_AGE=900
# REFRESH_TOKEN_MAX_AGE=604800
# BANK_DEPOSIT_INSTRUCTIONS="Bank: ... Account: ... IBAN: ..."
# PICKUP_LOCATION="Shop 1, Main Market, Lahore"
# PASSWORD_RESET_URL=http://localhost:5173/reset-password
# PASSWORD_RESET_TIMEOUT=3600
# PASSWORD_RESET_THROTTLE_RATE=5/hour
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=PixelForge <no-reply@pixelforge.com>

# Online payments — leave a provider's credentials empty to hide it at checkout.
# Providers must reach the callback URLs: use your public HTTPS domain, or an
# HTTPS tunnel (cloudflared/ngrok) to localhost:8000 during development.
# PAYMENT_RESULT_URL=http://localhost:5173/payment/result
# PAYMENT_EXPIRY_MINUTES=30
# PAYMENT_PROVIDER_TIMEOUT=20

# JazzCash (sandbox: https://sandbox.jazzcash.com.pk)
JAZZCASH_ENVIRONMENT=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=https://<your-tunnel-or-domain>/api/payments/jazzcash/callback/
# JAZZCASH_VERSION=1.1
# JAZZCASH_TXN_TYPE=            # empty = customer chooses; MWALLET, MIGS or OTC
# Production only (issued by JazzCash after approval):
# JAZZCASH_CHECKOUT_URL=
# JAZZCASH_INQUIRY_URL=

# Easypaisa / Easypay
EASYPAISA_ENVIRONMENT=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_RETURN_URL=https://<your-tunnel-or-domain>/api/payments/easypaisa/callback/
# EASYPAISA_PAYMENT_METHOD=MA_PAYMENT_METHOD
# EASYPAISA_CHECKOUT_URL=
# EASYPAISA_CONFIRM_URL=
# EASYPAISA_INQUIRY_URL=
