# Copy to .env for local development (python manage.py runserver).
DEBUG=True
SECRET_KEY=change-me
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pixelforge

# PostgreSQL primary as separate parts (takes precedence over DATABASE_URL when DB_PRIMARY_HOST is set).
# DB_PRIMARY_HOST=localhost
# DB_PRIMARY_PORT=5432
# DB_PRIMARY_NAME=pixelforge
# DB_PRIMARY_USER=postgres
# DB_PRIMARY_PASSWORD=

# Read replica (optional; unset = every query uses the primary). Unset parts default to the primary's.
# DB_REPLICA_HOST=localhost
# DB_REPLICA_PORT=5434
# DB_REPLICA_NAME=pixelforge
# DB_REPLICA_USER=postgres
# DB_REPLICA_PASSWORD=
# or: DATABASE_REPLICA_URL=postgres://user:password@replica-host:5432/pixelforge
# READ_REPLICA_ENABLED=True
# READ_REPLICA_APPS=catalog
# RECENT_WRITE_TTL=30           # seconds a caller's last write LSN is remembered (> REPLICA_MAX_LAG + REPLICA_HEALTH_INTERVAL)
# REPLICA_MAX_LAG=10            # seconds of lag after which all reads use the primary
# REPLICA_HEALTH_INTERVAL=5
# REPLICA_FAILURE_COOLDOWN=30
# REPLICA_CONNECT_TIMEOUT=2

# Several replicas, Django spreads reads over the healthy ones (aliases replica_1..N; takes precedence):
# READ_REPLICA_COUNT=3
# DB_REPLICA_1_HOST=replica1    # DB_REPLICA_<i>_PORT/NAME/USER/PASSWORD, or DATABASE_REPLICA_<i>_URL
# DB_REPLICA_2_HOST=replica2
# DB_REPLICA_3_HOST=replica3

# High availability: stable endpoints in front of an HA cluster (docker-compose.ha.yml, Aurora, ...).
# Credentials still come from DB_PRIMARY_* / DATABASE_URL (and DB_REPLICA_* for the reader).
# DB_WRITER_ENDPOINT=haproxy:5000   # always reaches the current primary
# DB_READER_ENDPOINT=haproxy:5001   # load-balanced healthy replicas
# FAILOVER_ENABLED=True             # report the HA manager's failover state; Django never promotes
# DB_HA_STATUS_URL=http://haproxy:8008
# DB_DESIRED_REPLICA_COUNT=3

# Redis cache (optional: without it every read goes to PostgreSQL). Docker Compose uses redis://redis:6379/1.
# With a password: redis://:<password>@host:6379/1
REDIS_URL=redis://127.0.0.1:6379/1
# CACHE_ENABLED=True
# CACHE_KEY_PREFIX=pixelforge
# CACHE_DEFAULT_TTL=300
# CACHE_TTL_JITTER=30
# NEGATIVE_CACHE_TTL=60
# NEGATIVE_CACHE_TTL_JITTER=15
# CACHE_LOCK_TTL=5.0
# CACHE_LOCK_WAIT_TIMEOUT=2.0
# CACHE_LOCK_RETRY_DELAY=0.05
# CACHE_LOCK_RETRY_MAX_DELAY=0.2
# CACHE_FAILURE_COOLDOWN=30
# REDIS_SOCKET_TIMEOUT=0.25
# CACHE_LOG_LEVEL=INFO          # DEBUG logs every hit/miss/set
# ACCESS_TOKEN_MAX_AGE=900
# REFRESH_TOKEN_MAX_AGE=604800
# BANK_DEPOSIT_INSTRUCTIONS="Bank: ... Account: ... IBAN: ..."
# PICKUP_LOCATION="Shop 1, Main Market, Lahore"
# PASSWORD_RESET_URL=http://localhost:5173/reset-password
# PASSWORD_RESET_TIMEOUT=3600
# PASSWORD_RESET_THROTTLE_RATE=5/hour
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=PixelForge <no-reply@pixelforge.com>

# Online payments — leave a provider's credentials empty to hide it at checkout.
# Providers must reach the callback URLs: use your public HTTPS domain, or an
# HTTPS tunnel (cloudflared/ngrok) to localhost:8000 during development.
# PAYMENT_RESULT_URL=http://localhost:5173/payment/result
# PAYMENT_EXPIRY_MINUTES=30
# PAYMENT_PROVIDER_TIMEOUT=20

# JazzCash (sandbox: https://sandbox.jazzcash.com.pk)
JAZZCASH_ENVIRONMENT=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=https://<your-tunnel-or-domain>/api/payments/jazzcash/callback/
# JAZZCASH_VERSION=1.1
# JAZZCASH_TXN_TYPE=            # empty = customer chooses; MWALLET, MIGS or OTC
# Production only (issued by JazzCash after approval):
# JAZZCASH_CHECKOUT_URL=
# JAZZCASH_INQUIRY_URL=

# Easypaisa / Easypay
EASYPAISA_ENVIRONMENT=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_RETURN_URL=https://<your-tunnel-or-domain>/api/payments/easypaisa/callback/
# EASYPAISA_PAYMENT_METHOD=MA_PAYMENT_METHOD
# EASYPAISA_CHECKOUT_URL=
# EASYPAISA_CONFIRM_URL=
# EASYPAISA_INQUIRY_URL=
